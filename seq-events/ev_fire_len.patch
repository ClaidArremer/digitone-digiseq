     return vel;
 }
 
+#ifdef DEV_FIRE_LEN
+/* The note's length, the device's LEN value as the fire would play it (the step's lock, else the
+ * track's LEN) */
+int32_t sq_on_len(int32_t track, int32_t step, int32_t len)
+{
+    const ev_fire_len_fn *h;
+    if ((uint32_t)track >= SQ_TRACKS || !ev_fire_len[0])
+        return len;
+    for (h = ev_fire_len; *h; h++) {
+        (*h)(track, step, &len);
+        len = len < 0 ? 0 : len > DEV_LEN_MAX ? DEV_LEN_MAX : len;
+    }
+    return len;
+}
+#endif
