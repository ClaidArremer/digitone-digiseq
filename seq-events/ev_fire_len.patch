diff --git a/mods/seq-events-dn1/seq.s b/mods/seq-events-dn1/seq.s
index bad5363..f4953f5 100644
--- a/mods/seq-events-dn1/seq.s
+++ b/mods/seq-events-dn1/seq.s
@@ -317,3 +317,49 @@ sq_site_slocks:
         lea     12(%sp), %sp
         move.l  #1500, %d0
         rts
+
+| ---- note length (ev_fire_len, 0.2) -------------------------------------
+
+| 0x40094668, over `mvs.b 192(a1),d7; cmp.l d7,d1` (a1 = track_t + step, a0
+| = track_t, d1 = -1): the step's LEN, -1 for the track's (track_t + 962),
+| which the stock reads after the branch. d7 leaves as the length to play
+| (never -1), so the branch takes it into a4 as a step's own. d0 is live.
+        .globl  sq_site_slen
+sq_site_slen:
+        mvs.b   192(%a1), %d7
+        cmp.l   %d1, %d7
+        bne.s   1f
+        mvs.b   962(%a0), %d7
+1:      lea     -16(%sp), %sp
+        movem.l %d0-%d1/%a0-%a1, (%sp)
+        move.l  %d7, -(%sp)
+        move.l  %d3, -(%sp)             | step
+        move.l  %d4, -(%sp)             | track
+        jsr     sq_on_len
+        lea     12(%sp), %sp
+        move.l  %d0, %d7
+        movem.l (%sp), %d0-%d1/%a0-%a1
+        lea     16(%sp), %sp
+        cmp.l   %d7, %d1
+        rts
+
+| 0x40094a0e (MIDI), over `mvs.b 192(a1),d7; movea.l d7,a4` (then `cmp.l
+| d7,d1` with d1 = -1 and the track's LEN on equal); d2 = step, d4 = track
+        .globl  sq_site_mlen
+sq_site_mlen:
+        mvs.b   192(%a1), %d7
+        cmp.l   %d1, %d7
+        bne.s   1f
+        mvs.b   962(%a0), %d7
+1:      lea     -16(%sp), %sp
+        movem.l %d0-%d1/%a0-%a1, (%sp)
+        move.l  %d7, -(%sp)
+        move.l  %d2, -(%sp)
+        move.l  %d4, -(%sp)
+        jsr     sq_on_len
+        lea     12(%sp), %sp
+        move.l  %d0, %d7
+        movem.l (%sp), %d0-%d1/%a0-%a1
+        lea     16(%sp), %sp
+        movea.l %d7, %a4
+        rts
